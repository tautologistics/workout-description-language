@id tabata:this

# Tabata This

sequence:
  8 rounds:
    work 20s: max Row
    rest 10s
    score: min per round
  rest 1min
  8 rounds:
    work 20s: max Air Squat
    rest 10s
    score: min per round
  rest 1min
  8 rounds:
    work 20s: max Pull-Up
    rest 10s
    score: min per round
  rest 1min
  8 rounds:
    work 20s: max Push-Up
    rest 10s
    score: min per round
  rest 1min
  8 rounds:
    work 20s: max Sit-Up
    rest 10s
    score: min per round

score: sum of blocks
