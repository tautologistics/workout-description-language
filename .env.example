# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# The root Makefile loads `.env` automatically when it exists, and exports the
# variables to the recipe environment — so the database and deploy targets
# (movements:load / movements:dump / workouts:load / vocab:load /
# deploy / deploy:dry / deploy:db / backups:pull) pick these up with no inline
# `VAR=… make …` prefix.
#
# GNU Make parses this file, so keep the values simple: no surrounding quotes,
# no `#` inside a value, no `$`. A `VAR=value` line set on the command line
# still wins over the Makefile's own `?=` defaults.

# --- PocketBase target ------------------------------------------------------
# Which instance the *:load / *:dump targets talk to. Leave unset for the local
# mock `/api` (a bare `make serve`, http://localhost:8081) — that is the
# scripts' own default. Set it to the live instance to load or dump prod.
#WDL_PB_URL=https://wex.androidempathy.com

# --- PocketBase admin auth ------------------------------------------------
# Writes only. Reads (movements:dump, and every list route) need no auth, and
# the local mock accepts any caller, so leave this whole block unset for local
# work.
#
# Either a pre-obtained token, used as-is …
#WDL_PB_ADMIN_TOKEN=

# … or an email + password exchanged at
# POST /api/collections/<collection>/auth-with-password.
#WDL_PB_ADMIN_EMAIL=chris@winberry.net
#WDL_PB_ADMIN_PASSWORD=

# The collection that email/password authenticates against. A PocketBase
# superuser (`_superusers`) can write every collection; a plain `users` row
# needs `admin: true` (deploy/README.md §7a) and satisfies movements + vocab
# but not workouts (owner-only write). `_superusers` is the safe choice for
# running all four loaders against prod.
#WDL_PB_ADMIN_COLLECTION=_superusers

# --- Deploy (make deploy / deploy:dry / deploy:db / backups:pull) --------
# SSH target for the VPS. The Makefile defaults this to the ~/.ssh/config alias
# `dreamhost.ae.wex`; override here or in the environment on another box.
#WDL_DEPLOY_SSH=androidempathy_wex@wex.androidempathy.com

# Remote pb_public directory for the static-app rsync (make deploy).
#WDL_DEPLOY_DIR=pb/pb_public

# Where `make backups:pull` drops the DB snapshots it fetches off the box.
# Defaults to the repo-relative `db-backups/` (git-ignored contents). Set an
# absolute path here to keep backups outside the repo.
#WDL_BACKUP_DIR=/absolute/path/to/db-backups
