# Copy to  deploy/pocketbase/pocketbase.env  on the box and fill in.
# That file is gitignored — secrets never enter the repo (DEC-016 / CLAUDE.md).
#
# PocketBase reads none of these directly; they are here so the runbook and any
# wrapper have one place to look. The Google client id/secret are entered in the
# PocketBase admin UI (Collections -> users -> Options -> OAuth2 -> Google), not
# from a file.

# The vhost hostname. Feeds the OAuth redirect URL and the panel proxy.
WDL_DOMAIN=wex.androidempathy.com

# Where PocketBase lives on the box.
PB_DIR=/home/<ssh-user>/pb
PB_BIND=0.0.0.0:8090          # 0.0.0.0, not 127.0.0.1 — DreamHost proxy needs it

# Google OAuth2 — from Google Cloud Console -> APIs & Services -> Credentials.
# Stored here only as a backup of what was typed into the admin UI. Keep this
# file mode 600.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# PocketBase superuser — RECORD IN A PASSWORD MANAGER, not here. Left blank on
# purpose; this line is a reminder of what exists, not storage for it.
PB_SUPERUSER_EMAIL=you@example.com
