// WDL 0.1 — normative grammar, phase 2.
//
// Status: this file states every kind of line phase 2 reads — the step line, the
// block header with its comma modifiers, rest, score, and the preamble
// (directives, title, variants). What is left to prose in spec-0.1.md is the
// *assembly*: which score an `on cap:` line qualifies, which variant a field
// belongs to, which block a child belongs to. Those are questions about several
// lines and this is a grammar over one.
//
// Phase 1 is not here and never will be: `readLines` turns indentation into a
// tree and knows nothing about workouts. Which *kind* of line this is remains the
// caller's question, and for the two kinds marked by punctuation rather than by a
// keyword it is keyed on the markers phase 1 already sees — a leading `- ` opens a
// step, a trailing `:` opens a block — so neither marker appears in the rules
// below. That the colon is what tells `21-15-9` (a rep scheme) from `8-12` (a
// rep range) is therefore stated as *which start rule the caller picks*, and the
// two shapes never have to be told apart inside one derivation. The line kinds
// that carry a keyword — `rest`, `score:`, `@`, `#` — do state it, so their rules
// select the lines they apply to.
//
// Start rules, one per kind: `step`, `blockHeader`, `restLine`, `scoreLine`,
// `scoreQualifierLine`, `directiveLine`, `titleLine`, `variantLine`, `fieldLine`.
//
// This grammar is normative: where it and spec-0.1.md disagree, this file is
// right and the prose is a bug. It carries no semantic actions on purpose —
// what each production *means* is a separate semantics file, so this stays
// readable as a contract and portable to any implementation.
//
// Notation is Ohm, which is PEG-based, and the choice is load-bearing. WDL's
// rules are inherently *ordered*: `each arm` must be tried before bare `each`,
// `min` before a bare `m`, a laterality word before an rx split. EBNF's
// alternation is unordered, so every one of those would need a prose caveat
// beside it — which is how a spec ends up being prose beside an implementation
// again. Here `|` means "try in this order", so the ordering *is* the
// specification and the grammar is unambiguous by construction.
//
// **The parser runs on this file.** As of 2026-08-15, `packages/core/src/parse.ts`
// matches these rules and walks them with the semantics under
// `packages/core/src/grammar/`; there is no second reading of a WDL line
// anywhere, and no generation step between this file and the thing that runs it.
// A host hands the text over the way it hands over the movement registry —
// `packages/core/node.ts` reads it, a browser fetches it — because nothing under
// `src/` opens a file.
//
// Verified, on every run: `packages/core/test/grammar.test.ts` feeds every line
// of every kind in examples/corpus, in spec-0.1.md and in the vocabulary suite to
// the start rule for its kind, and derives the counts rather than asserting them.
// The lines no rule reads are listed there with a reason each, and a line that
// starts reading fails as stale. What each line *means* is pinned in
// packages/core/test/golden/vocabulary.json.
//
// It ran *beside* a hand-written regex chain for a day before that, which is
// where the numbers in docs/grammar-exploration.md come from and how the
// `@`-plus-digit family was found: the two implementations disagreed, and the
// grammar was right.


WDL {

  // Every rule is lexical (lowercase) on purpose. Ohm's syntactic rules skip
  // whitespace implicitly, and in WDL a single space *is* the meaning:
  // `@tiebreak` is a flag, `@ 95lb` is a load. Space is never incidental here.

  // ================== the step line ==================

  step = oneStep orTail*
  orTail = spaces orSep spaces oneStep

  orSep = caseInsensitive<"or"> ~wordChar  -- word
        | "|"                              -- pipe
        | "/" ~digit                       -- slash

  oneStep = leadQuantity? altPrefix? movement spacedPart* commaModifier*

  spacedPart = spaces stepPart
  // The modifier is optional, and that is forgiveness rather than laxity: a
  // comma with nothing after it separates nothing, so `10 Thruster,` is ten
  // thrusters. Required, one stray comma makes the whole line unreadable and
  // takes the movement and the amount down with it — which is a steep price for
  // a keystroke, and the at-rest format is written on a whiteboard by hand.
  commaModifier = spaces "," spaces modifier?

  // ---------- the movement name: an open vocabulary ----------
  //
  // Defined negatively — the words that are not something else. This is the
  // whole trick, and what peelTrailingQualifiers hand-rolls in reverse.

  movement = movChar+
  movChar = ~stepPartStart ~"," ~orSep any

  // A qualifier is only a qualifier if the part *ends* there. The `x10` in
  // `3x10 Curl` is followed by more of the movement name, so it belongs to the
  // name — which is what `peelTrailingQualifiers` means by only ever stripping
  // from the end, and what a rule reading left to right has to say out loud.
  // (Whether `3x10 Curl` *should* mean three sets of ten is a separate question,
  // and neither implementation reads it that way today — see known-debts.md.)
  stepPartStart = "@" | qualifiedPart
  qualifiedPart = (laterality | rxSplit | trailingQualifier | threshold) partEnd

  // What may follow a part: another part, a comma, an `@`, or the end of the line.
  partEnd = &spacedBoundary | &spacedPart | end
  spacedBoundary = spaces ("," | "@")

  altPrefix = altWord ~wordChar spaces
  altWord = caseInsensitive<"alternating"> | caseInsensitive<"alt">

  // ---------- quantity: shared with the block header ----------
  //
  // This is the layer the two halves of phase 2 have in common, and the reason
  // headers were stated here before the parser was swapped over to any of it.
  // A duration appears in `12min Bike`, in `cap 12min`, in `every 90s` and in
  // `AMRAP 12min`; a target appears after a step's `@` and after a header's.
  // Stated once, they cannot drift; stated twice, they would.

  leadQuantity = threshold                                              -- threshold
               | durationQty spaces maxWord ~letter spaces              -- clockMax
               | maxWord ~letter spaces                                 -- max
               | setsByReps spaces                                      -- setsByReps
               | unreadableRange spaces                                 -- unreadableRange
               | anyQuantity spaces                                     -- plain

  maxWord = caseInsensitive<"max">

  // `100-150ft Farmers Carry` — a range is a rep range (spec §3's unit table
  // says so, in so many words), and a range with a unit stapled on is a shape
  // the language does not have a reading for. Matched here, ahead of
  // `anyQuantity`, so it is *caught* rather than left to fall through: with no
  // rule claiming it, `100-150ft` was not a quantity at all, so the whole
  // token — number, dash and unit alike — became the front of the movement
  // name, `wdl check` never saw a quantity to be missing, and `wdl fmt`
  // pluralized text nobody meant as a noun. This does not teach the range a
  // unit; it only stops the silence, so `unreadableRange` reads as `open` with
  // the raw text kept in `Step.unknown` — the same held-and-reported treatment
  // an unrecognized comma modifier already gets (see `step-semantics.ts`).
  // Whether a range *should* carry a unit is queue item 5's other half, left
  // open in docs/context/ready-to-pick-up.md.
  unreadableRange = integer "-" integer letter+ ~wordChar

  // `5x5 Back Squat`, `3x10 Curl` — **sets** times **reps**, in that order,
  // which is how a gym writes it and how spec §1's own design rule 4 writes it.
  // It says exactly what the trailing `x5` says (`10 Curl x3` is `3x10 Curl`),
  // so it sets `sets` and the rep count and adds no third concept.
  //
  // The `~wordChar` is what keeps it from eating a load: `2x35lb` has a letter
  // after the second number, so it is not this — a target's `2x35lb` is two
  // thirty-five-pound dumbbells and has nothing to do with sets.
  setsByReps = integer caseInsensitive<"x"> integer ~wordChar

  // A quantity is a whole whitespace-delimited token, or `3/4 Sit-Up` reads
  // its leading `3` as three reps of a movement called `/4 Sit-Up`.
  anyQuantity = quantityBody tokenEnd
  quantityBody = spacedQuantity | unspacedQuantity
  tokenEnd = &space | end

  // The boundary after a unit is "not a word character", not "not a letter",
  // or `1min30s` reads as a spaced `1 min` with `30s` left over.
  spacedQuantity = number spaces calWord ~wordChar   -- cal
                 | number spaces repWord ~wordChar   -- reps
                 | number spaces durWord ~wordChar   -- duration
                 | number spaces distWord ~wordChar  -- distance

  // Distance before duration is what makes `400m` metres and `12min` minutes.
  unspacedQuantity = integer "-" integer ~wordChar ~"-"        -- range
                   | integer "+" ~wordChar                     -- floor
                   | number distUnit ~wordChar                 -- distance
                   | integer calWord ~wordChar                 -- cal
                   | durationQty                               -- duration
                   | integer ~wordChar ~"%"                    -- reps

  durationQty = integer hourUnit minPart? secPart? ~wordChar   -- hms
              | integer minUnit secPart? ~wordChar             -- ms
              | integer secUnit ~wordChar                      -- s
              | integer ":" clockSeconds                       -- clock

  minPart = integer minUnit
  secPart = integer secUnit
  hourUnit = caseInsensitive<"h">
  secUnit = caseInsensitive<"s">
  minUnit = caseInsensitive<"min">      -- long
          | caseInsensitive<"m"> ~letter -- short
  clockSeconds = ("0".."5") digit

  calWord = caseInsensitive<"calories"> | caseInsensitive<"cal">
  repWord = caseInsensitive<"reps"> | caseInsensitive<"rep">

  // Named one list per unit rather than left inline, because the rest line needs
  // the same three lists: spec §3 accepts these spellings "wherever a duration is
  // expected", and a rest is a duration position. Stated twice they would drift,
  // which is the argument the shared quantity layer above is already making.
  durWord = minuteWords  -- minutes
          | secondWords  -- seconds
          | hourWords    -- hours

  minuteWords = caseInsensitive<"minutes"> | caseInsensitive<"minute">
              | caseInsensitive<"mins"> | caseInsensitive<"min">
  secondWords = caseInsensitive<"seconds"> | caseInsensitive<"second">
              | caseInsensitive<"secs"> | caseInsensitive<"sec">
  hourWords = caseInsensitive<"hours"> | caseInsensitive<"hour">

  distWord = (caseInsensitive<"meters"> | caseInsensitive<"metres">
             | caseInsensitive<"meter"> | caseInsensitive<"metre">)  -- metres
           | (caseInsensitive<"miles"> | caseInsensitive<"mile">)    -- miles
           | caseInsensitive<"feet">                                 -- feet
           | distUnit                                                -- unit

  distUnit = caseInsensitive<"km"> | caseInsensitive<"mi">
           | caseInsensitive<"ft"> | caseInsensitive<"yd">
           | caseInsensitive<"m">

  // `Bike until HR > 160bpm`. The zone digit is a whole token: without that,
  // `> 160bpm` reads as zone 1 and leaves `60bpm` on the floor.
  threshold = untilWord spaces metric spaces compare spaces zoneRef            -- zone
            | untilWord spaces metric spaces compare spaces number spaces rateUnit?  -- value

  untilWord = caseInsensitive<"until">
  zoneRef = (caseInsensitive<"zone"> spaces)? caseInsensitive<"z">? digit ~wordChar ~"."
  rateUnit = caseInsensitive<"bpm"> | caseInsensitive<"watts"> | caseInsensitive<"w">
  metric = caseInsensitive<"hr">                                   -- hr
         | caseInsensitive<"heart"> spaces caseInsensitive<"rate"> -- heartRate
         | caseInsensitive<"power">                                -- power

  // The parentheses are load-bearing: `--` names the alternative immediately
  // before it, not the group, so without them only the last spelling is named.
  compare = ("<" | caseInsensitive<"below"> | caseInsensitive<"under">)  -- lt
          | (">" | caseInsensitive<"above"> | caseInsensitive<"over">)   -- gt

  // ---------- what may trail a movement ----------

  stepPart = targetGroup<never> | laterality | rxSplit | thresholdPart | trailingQualifier

  // A threshold trailing a movement becomes that step's completion condition.
  thresholdPart = threshold

  // What follows an `@` is a target unless it is a flag, and **the first
  // character after the `@` is what decides**: a letter opens a flag, a digit
  // opens a load. So `@95lb`, `@ 95lb`, `@95` and `@ 95` all read the same way —
  // as targets — and whether a unit is present has nothing to do with it.
  // Nobody writes a flag called `95lb`, and `@95` on a whiteboard is a weight.
  //
  // The flag form additionally requires the `@` to be tight against the word,
  // and that is not symmetry for its own sake: a *spaced* target legitimately
  // begins with a letter — `@ Z2`, `@ RPE 8`, `@ marathon pace`,
  // `@ of heavy-single` — so the space cannot be ignored on the letter side the
  // way it is on the digit side. `@ tiebreak` is therefore a target, read like
  // those, and that is stated here rather than left to fall out of the ordering.
  //
  // **The parameter is where the target's text stops, and it differs by
  // position.** A target is prose — `marathon pace`, `85% of heavy-single`,
  // `1:45/500m` — so it runs to the end of its segment and the rule is written
  // that way. In a *header* one more phrase ends it: `for time` is a score and
  // may be fused onto any header, so `3 rounds @ 95lb for time` is a load and a
  // score, not a load called `95lb for time`. That is one rule with one
  // parameter rather than a header-local copy of five, because it really is one
  // rule — the same target, read up to a different boundary. `never` is the
  // boundary everywhere else, and it is a rule that cannot match anything.
  targetGroup<stop> = "@" flagName                  -- flag
                    | "@" spaces targetText<stop>   -- target

  never = ~any any

  flagName = letter (~space ~"," any)*

  targetText<stop> = targetAtom<stop> toTail<stop>*
  toTail<stop> = spaces caseInsensitive<"to"> spaces targetAtom<stop>

  targetAtom<stop> = targetChar<stop>+
  targetChar<stop> = ~"@" ~"," ~(space+ stop)
                     ~(space+ caseInsensitive<"to"> ~wordChar)
                     ~(space+ trailingQualifier partEnd) any

  laterality = "(" lateralityWord ")"
  lateralityWord = caseInsensitive<"both"> | caseInsensitive<"split">
                 | caseInsensitive<"per-side"> | caseInsensitive<"total">

  // `(women 105lb / men 145lb)`, or `(105/145)` where the larger is the men's.
  rxSplit = "(" spaces rxSide spaces "/" spaces rxSide spaces ")"
  rxSide = whoPrefix? number spaces loadUnit?
  whoPrefix = whoWord spaces
  whoWord = caseInsensitive<"women"> | caseInsensitive<"men">
          | caseInsensitive<"w"> | caseInsensitive<"m">
  loadUnit = caseInsensitive<"lbs"> | caseInsensitive<"lb">
           | caseInsensitive<"kgs"> | caseInsensitive<"kg">
           | "#" | caseInsensitive<"pood">

  // Order matters twice: `each arm` before bare `each`, limb before team.
  trailingQualifier = eachWord ~wordChar spaces limbWord ~wordChar     -- limb
                    | sideWord ~wordChar spaces sideLimb ~wordChar     -- side
                    | teamWord ~wordChar                               -- team
                    | altWord ~wordChar                                -- alternating
                    | stepFlagWord ~wordChar                           -- flag
                    | caseInsensitive<"x"> spaces integer ~wordChar    -- sets

  eachWord = caseInsensitive<"each"> | caseInsensitive<"per">
  limbWord = caseInsensitive<"arm"> | caseInsensitive<"leg">
           | caseInsensitive<"side"> | caseInsensitive<"hand">
  sideWord = caseInsensitive<"first"> | caseInsensitive<"second">
           | caseInsensitive<"left"> | caseInsensitive<"right">
  sideLimb = caseInsensitive<"arm"> | caseInsensitive<"leg"> | caseInsensitive<"side">
  teamWord = caseInsensitive<"shared"> | caseInsensitive<"synchronized">
           | caseInsensitive<"each">
  stepFlagWord = caseInsensitive<"unbroken"> | caseInsensitive<"building">
               | caseInsensitive<"reversed">

  // ---------- comma-separated modifiers ----------

  modifier = caseInsensitive<"tempo"> spaces word                        -- tempo
           | caseInsensitive<"count"> spaces countWord                   -- count
           | "+" integer spaces caseInsensitive<"each"> spaces caseInsensitive<"round">  -- perRound
           | trailingQualifier                                           -- qualifier
           | caseInsensitive<"note:"> spaces quotedOrRest                -- note
           | modFlagWord ~wordChar                                       -- flag
           | noteWord ~wordChar restOfPart                               -- prose
           | targetGroup<never>                                          -- target
           | unknown                                                     -- unknown

  countWord = caseInsensitive<"calories"> | caseInsensitive<"cal">
            | caseInsensitive<"reps"> | caseInsensitive<"distance">
  modFlagWord = caseInsensitive<"building"> | caseInsensitive<"unbroken">
              | caseInsensitive<"open"> | caseInsensitive<"reversed">
  noteWord = caseInsensitive<"ramp"> | caseInsensitive<"wearing">

  // Everything the grammar does not recognize: a production, not a failure and
  // not a guess. Held verbatim, round-trips, means nothing anywhere.
  unknown = restOfPart

  restOfPart = partChar+
  partChar = ~"," any

  quotedOrRest = "\"" (~"\"" any)* "\""  -- quoted
               | (~"," any)*             -- bare

  // ================== the block header ==================
  //
  // The content of a line that ends in `:`, with the colon itself left to the
  // caller for the reason given at the top of this file. Structurally a header
  // is one *kind* — what the block is — plus anything that qualifies it: an `@`
  // target the children inherit, `for time`, and comma-separated modifiers.
  //
  // `for time` is not a kind. It is a score, and it may be fused onto a kind
  // (`3 rounds for time`) or stand alone (`for time:`, a plain sequence scored
  // by the clock), so it is one production used in both places rather than two
  // spellings of one idea.

  blockHeader = headerHead headerModifier*

  headerHead = headerKind? headerExtra*
  headerExtra = spaces (forTime | targetGroup<forTime>)
  // Optional for the same reason `commaModifier`'s is: `3 rounds,:` is three
  // rounds, not a header nobody can read.
  //
  // The trailing extras say that **whatever may qualify a header before a comma
  // may qualify it after one**, which is a thing worth stating rather than a
  // convenience. Without them `3 rounds, @ 95lb for time` had nowhere to put the
  // `for time` once the target stopped swallowing it, and the whole header
  // became unreadable — a strictly worse answer than the greedy one it replaced.
  // With them the two spellings agree, which is the property the stop parameter
  // exists to buy in the first place.
  headerModifier = spaces "," spaces blockModifier? headerExtra*

  forTime = caseInsensitive<"for"> spaces caseInsensitive<"time"> ~wordChar

  // A kind is the *whole* of what it claims, up to a comma, an `@`, or
  // `for time`. Without that, `3 rounds of madness:` would read `3 rounds` and
  // choke on the rest instead of falling through to the unknown production —
  // in a PEG an alternative that succeeds is never reconsidered, so "the whole
  // of it" has to be said here rather than assumed.
  headEnd = ~moreHead
  moreHead = spaces ~"," ~"@" ~forTime any

  // `headerName` is last and matches anything: an unrecognized header is held as
  // a named sequence rather than rejected. It is separated from the kinds proper
  // because `blockModifier` needs the kinds *without* it — a fallback that
  // matches everything, offered after a comma, would swallow every unrecognized
  // modifier as a block name and leave `unknown` unreachable.
  headerKind = blockKind   -- known
             | headerName  -- unknown

  // Ordered as the implementation orders them, so the two can be read side by
  // side.
  //
  // A kind may be stated in **any** comma position, not only first — spec §5.0's
  // "order is free on input" is about the whole header and not about its opening
  // segment, so `for time, 3 rounds` and `3 rounds for time` are one block. This
  // rule is therefore reached from two places, and that is the whole of the fix
  // for the family of defects where a head that parsed alone (`for time`) took
  // the kind after it as unrecognized text.
  blockKind = integer spaces roundWord headEnd                    -- rounds
            // `3 RFT` is `3 rounds for time` said short, so it is one production
            // fusing the round word and the score rather than a spelling of
            // `roundWord` — the `for time` is inside the abbreviation and there
            // is nowhere else on the line for it to come from. A *bare* `RFT:`
            // is deliberately not here: see spec §5.2.
            | integer spaces caseInsensitive<"rft"> headEnd       -- roundsForTime
            | integer spaces attemptWord headEnd                  -- attempts
            | caseInsensitive<"team"> spaces caseInsensitive<"of">
              spaces integer headEnd                              -- teamOf
            | ladder                                              -- ladder
            | caseInsensitive<"for"> spaces headerDuration headEnd -- forDuration
            | caseInsensitive<"amrap"> amrapWindow? headEnd       -- amrap
            | caseInsensitive<"e"> integer? caseInsensitive<"mom">
              spaces headerDuration headEnd                       -- emom
            | every                                               -- every
            | caseInsensitive<"work"> spaces headerDuration headEnd -- work
            | minuteWord spaces integer headEnd                   -- cycleEntry
            | caseInsensitive<"partner"> spaces
              caseInsensitive<"rotation"> headEnd                 -- partnerRotation
            | caseInsensitive<"any"> spaces caseInsensitive<"order"> headEnd -- tally
            | caseInsensitive<"superset"> headEnd                 -- superset
            | caseInsensitive<"complex"> headEnd                  -- complex
            | caseInsensitive<"sequence"> headEnd                 -- sequence
            | build                                               -- build
            | sectionWord headEnd                                 -- section

  roundWord = caseInsensitive<"rounds"> | caseInsensitive<"round">
            | caseInsensitive<"sets"> | caseInsensitive<"set">
  attemptWord = caseInsensitive<"attempts"> | caseInsensitive<"attempt">
  minuteWord = caseInsensitive<"minute"> | caseInsensitive<"min">

  // A bare number in a header duration position is minutes — `AMRAP 12`,
  // `every 5`. Nowhere else in the language does a bare number mean time.
  headerDuration = durationQty        -- exact
                 | integer ~wordChar  -- minutes
  amrapWindow = spaces headerDuration

  // `every 90s`, `every 1min until failure`, `every 3min x 5`,
  // `every 90s for 12min`. The bounded forms come first or their tails are left
  // dangling.
  //
  // The `for` spelling is how the interval is said out loud — *every ninety
  // seconds for twelve minutes* — and it is also what `headerText` writes for a
  // clock bounded by a duration whose window is not whole minutes. Stating it
  // here is what makes that output legal: a formatter emitting a spelling no rule
  // reads is not a formatting defect but a destructive one, because an
  // unreadable header is held as a named sequence and the round trip settles.
  every = everyWord spaces headerDuration spaces caseInsensitive<"until">
          spaces caseInsensitive<"failure"> headEnd                -- untilFailure
        | everyWord spaces headerDuration spaces caseInsensitive<"for">
          spaces headerDuration headEnd                            -- forDuration
        | everyWord spaces headerDuration spaces ("x" | "×")
          spaces integer headEnd                                   -- times
        | everyWord spaces headerDuration headEnd                  -- bare
  everyWord = caseInsensitive<"every">

  // `21-15-9`, `1..10`, `1..5..1`, and with a unit `250-500-750 m` or
  // `1..5..1 min`. A scheme counts reps unless it says otherwise, so the unit
  // form is tried first — matched second, the unit would be left over.
  ladder = schemeNumbers spaces schemeUnit ~wordChar headEnd  -- unit
         | schemeNumbers headEnd                              -- reps

  // `..` states the endpoints of a run and every number between them is
  // implied; `-` states every tier. Ten-tier ladders are common enough that
  // spelling each number out is its own source of transcription errors.
  schemeNumbers = integer runTail+   -- run
                | integer tierTail+  -- tiers
  runTail = ".." integer
  tierTail = "-" integer

  // `min` before `mi` before `m`, and this one is not decoration: written the
  // other way round, `1..5..1 min` matches `mi` and chokes on the `n`, because a
  // PEG never reconsiders an alternative that succeeded.
  schemeUnit = caseInsensitive<"min"> | caseInsensitive<"mi">
             | caseInsensitive<"km"> | caseInsensitive<"ft">
             | caseInsensitive<"yd"> | caseInsensitive<"cal">
             | caseInsensitive<"m"> | caseInsensitive<"s">

  // `build to a heavy single in 15min as heavy-single`. The goal is prose — it
  // is what the athlete is aiming at, not a quantity — so it runs to the ` in `.
  build = caseInsensitive<"build"> spaces caseInsensitive<"to"> spaces buildGoal
          spaces caseInsensitive<"in"> spaces headerDuration buildLabel? headEnd
  buildGoal = buildGoalChar+
  buildGoalChar = ~"," ~"@" ~(space+ caseInsensitive<"in"> space) any
  buildLabel = spaces caseInsensitive<"as"> spaces label

  sectionWord = caseInsensitive<"warm-up"> | caseInsensitive<"warmup">
              | caseInsensitive<"strength"> | caseInsensitive<"skill">
              | caseInsensitive<"conditioning"> | caseInsensitive<"accessory">
              | caseInsensitive<"cool-down"> | caseInsensitive<"cooldown">

  // Anything else. Held as the block's name, the same way `unknown` holds an
  // unrecognized step modifier: not an error and not a guess. It stops short of
  // an `@` and of `for time`, because those qualify a header of any kind
  // including one nobody taught the grammar.
  headerName = ~forTime headerNameChar+
  headerNameChar = ~"," ~"@" ~(space+ forTime) any

  // ---------- what may qualify a header, after a comma ----------

  blockModifier = caseInsensitive<"cap"> spaces headerDuration modEnd  -- cap
                | overrunWord spaces caseInsensitive<"on"> spaces
                  caseInsensitive<"overrun"> modEnd                   -- overrun
                | caseInsensitive<"wearing"> spaces restOfPart        -- wearing
                | caseInsensitive<"as"> spaces label modEnd           -- label
                | forTime modEnd                                     -- forTime
                | blockFlagWord modEnd                               -- flag
                | targetGroup<forTime>                                -- target
                // What the block *is*, stated after a comma rather than first.
                // Tried second-to-last, so every modifier that has a spelling of
                // its own keeps it, and only then is a segment offered to the
                // kinds. `unknown` stays last and stays reachable, which is why
                // this is `blockKind` and not `headerKind`.
                | blockKind                                          -- kind
                | unknown                                            -- unknown

  modEnd = ~moreMod
  moreMod = spaces ~"," any
  overrunWord = caseInsensitive<"carry"> | caseInsensitive<"cut"> | caseInsensitive<"fail">
  blockFlagWord = caseInsensitive<"building"> | caseInsensitive<"unbroken">
                | caseInsensitive<"synchronized"> | caseInsensitive<"shared">
  label = nameChar+

  // ================== the rest line ==================
  //
  // A rest is bounded by a clock, by the athlete, by the work that preceded it,
  // by a sensor reading, or by work of its own. `after last` is a separate fact
  // about *which* rest and can sit after any of them (spec §5.2, N1).

  restLine = restWord ~wordChar restBody? trailingAfterLast?
  restWord = caseInsensitive<"rest">
  restBody = spaces restSpec
  trailingAfterLast = spaces afterLast
  afterLast = caseInsensitive<"after"> spaces caseInsensitive<"last"> ~wordChar

  restSpec = threshold                 -- threshold
           | asNeeded                  -- asNeeded
           | equalToWork               -- equalToWork
           | looseDuration ~moreRest   -- duration
           | activeRecovery            -- active

  asNeeded = caseInsensitive<"as"> spaces caseInsensitive<"needed">
  equalToWork = "=" spaces workWord                                       -- sign
              | caseInsensitive<"equal"> spaces caseInsensitive<"to">
                spaces workWord                                           -- words
  workWord = caseInsensitive<"work"> ~wordChar

  // A duration *is* the whole of a rest line — nothing follows it — so
  // `rest 2 Push-Up` is two push-ups of active recovery and not two minutes with
  // a movement left over. Only `after last` may trail it.
  moreRest = ~afterLast any

  // Here, and only here, a duration's internal spacing is free: `rest 1 min 30 s`
  // is `rest 1min30s`, because there is no movement name after it for the spaces
  // to be confused with. In a step line that licence would make `1min30s` read as
  // `1 min` with `30s` left over.
  // No `~wordChar` guard after a unit here, and that is not an oversight: after
  // `min` in `1min30s` comes a digit, so such a guard would refuse the compound
  // form. What bounds a loose duration is `~moreRest` above — it is the whole of
  // the rest line — which is a stronger statement than any per-unit guard.
  looseDuration = looseHours looseMinutes? looseSeconds?  -- hms
                | looseMinutes looseSeconds?              -- ms
                | looseSeconds                            -- s
                | integer ":" clockSeconds spaces         -- clock
                | integer ~wordChar spaces                -- minutes
  looseHours = integer spaces looseHourUnit spaces
  looseMinutes = integer spaces looseMinUnit spaces
  looseSeconds = integer spaces looseSecUnit spaces

  // A rest takes the spelled-out spellings as well as the compact ones, because
  // spec §3 accepts them "wherever a duration is expected" and a rest is a
  // duration position. It did not, and that was the defect: `45 seconds Plank`
  // was 45 seconds while `rest 45 seconds` was an `unreadable rest duration`
  // *and* a rest with no bound at all — which everything downstream reads as
  // unbounded, so the line meant the opposite of what it said.
  //
  // The word list first and the symbol second, which is the ordering rule this
  // grammar has now been bitten by three times: `secondWords` before `secUnit`,
  // or `seconds` matches the `s` and chokes on `econds`.
  looseHourUnit = hourWords | hourUnit
  looseMinUnit = minuteWords | minUnit
  looseSecUnit = secondWords | secUnit

  // `rest 400m Jog` — the interval is work, not a clock.
  activeRecovery = anyQuantity spaces restMovement
  restMovement = restMovChar+
  restMovChar = ~(space+ afterLast) any

  // ================== the score line ==================
  //
  // Unlike a step or a header, a score line carries its own keyword, so this rule
  // selects the lines it applies to rather than being pointed at them. `on cap:`
  // and `tiebreak:` are lines of their own that qualify the score above them.

  scoreLine = scoreWord ":" spaces scoreSpec?
  scoreWord = caseInsensitive<"score">

  scoreQualifierLine = onCapLine | tiebreakLine
  onCapLine = caseInsensitive<"on"> spaces caseInsensitive<"cap"> ":" spaces restOfLine
  tiebreakLine = caseInsensitive<"tiebreak"> ":" spaces restOfLine
  restOfLine = any+

  scoreSpec = braceScore                             -- brace
            | aggregateWord spaces perRound          -- aggregatePerRound
            | scoreText spaces perRound              -- perRound
            | caseInsensitive<"sum"> spaces caseInsensitive<"of">
              spaces caseInsensitive<"blocks">       -- sumOfBlocks
            | scoreText                              -- plain

  aggregateWord = caseInsensitive<"min"> | caseInsensitive<"max"> | caseInsensitive<"sum">
  perRound = caseInsensitive<"per"> spaces caseInsensitive<"round"> ~wordChar

  // What is scored is prose — `rounds + reps`, `load`, `checkpoints` — so it is
  // whatever is there, stopping only where a `per round` suffix begins.
  scoreText = scoreChar+
  scoreChar = ~(space+ perRound) any

  // `score: {primary: time, tiebreak: reps at 5min}`. The brace form exists so a
  // compound score fits on one line; a *named* field is the only thing that
  // qualifies, and an entry naming anything else is held and means nothing.
  braceScore = "{" braceEntry braceEntryTail* "}"
  braceEntryTail = "," braceEntry
  braceEntry = spaces braceField ":" spaces braceValue  -- field
             | spaces braceValue                        -- other
  braceField = caseInsensitive<"primary">                            -- primary
             | caseInsensitive<"on"> spaces caseInsensitive<"cap">   -- onCap
             | caseInsensitive<"tiebreak">                           -- tiebreak
  braceValue = braceValueChar*
  braceValueChar = ~"," ~"}" any

  // ================== the preamble ==================
  //
  // Lines that describe the workout rather than the work. Each carries its own
  // marker, so like the score line these rules select what they apply to.

  // `@id crossfit:fran`, `@wdl 0.1`, `@tags conditioning, benchmark`. The value is
  // whatever follows and is never interpreted here — an `@id` is any unique
  // string, deliberately (roadmap §3.2.1), so there is nothing to state about it.
  directiveLine = "@" directiveKey directiveValue?
  directiveKey = nameChar+
  directiveValue = spaces restOfLine

  titleLine = "#"+ spaces restOfLine?

  variantsLine = caseInsensitive<"variants"> ":" spaces

  // `women:` opening a variant, with its fields either inline in braces or
  // indented under it. Both spellings exist because one variant with one field is
  // a line where three with three fields is a table (spec §11). *Which* variant a
  // field belongs to is a question about lines rather than about one line, so like
  // `on cap:` it stays with the caller.
  variantLine = variantName ":" spaces inlineFields?
  variantName = nameChar+

  // A comma separates fields inside braces and cannot appear in a value there; on
  // a line of its own a value runs to the end and a comma is just a comma. Two
  // rules because that really is two rules, not one with an exception.
  inlineFields = "{" spaces inlineField inlineFieldTail* spaces "}"
  inlineFieldTail = "," spaces inlineField
  inlineField = fieldKey ":" spaces inlineFieldValue
  inlineFieldValue = inlineFieldChar+
  inlineFieldChar = ~"," ~"}" any

  fieldLine = fieldKey ":" spaces restOfLine
  fieldKey = nameChar+

  // ---------- lexical ----------

  nameChar = alnum | "_" | "-"
  number = digit+ ("." digit+)?
  integer = digit+
  wordChar = alnum | "_"
  word = (~space ~"," any)+
}
